<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://www.w3.org/TR/REC-html40"><head><!--[if gte mso 9]><xml><x:ExcelWorkbook><x:ExcelWorksheets><x:ExcelWorksheet><x:Name>Worksheet</x:Name><x:WorksheetOptions><x:DisplayGridlines/></x:WorksheetOptions></x:ExcelWorksheet></x:ExcelWorksheets></x:ExcelWorkbook></xml><![endif]--></head><body><table>
    
    

   
   <thead>

      
      <tr class="over_header"><th></th>
         <th aria-label="" data-stat="header_tmp" colspan="16" class=" over_header center">Advanced Box Score Stats</th>
      </tr>
            
      <tr>
         <th aria-label="Starters" data-stat="player" scope="col" class=" poptip sort_default_asc center">Starters</th>
         <th aria-label="Minutes Played" data-stat="mp" scope="col" class=" poptip center" data-tip="Minutes Played" data-over-header="Advanced Box Score Stats">MP</th>
         <th aria-label="True Shooting Percentage" data-stat="ts_pct" scope="col" class=" poptip center" data-tip="&lt;strong&gt;True Shooting Percentage&lt;/strong&gt;&lt;br&gt;A measure of shooting efficiency that takes into account 2-point field goals, 3-point field goals, and free throws." data-over-header="Advanced Box Score Stats">TS%</th>
         <th aria-label="Effective Field Goal Percentage" data-stat="efg_pct" scope="col" class=" poptip center" data-tip="&lt;strong&gt;Effective Field Goal Percentage&lt;/strong&gt;&lt;br&gt;This statistic adjusts for the fact that a 3-point field goal is worth one more point than a 2-point field goal." data-over-header="Advanced Box Score Stats">eFG%</th>
         <th aria-label="3-Point Attempt Rate" data-stat="fg3a_per_fga_pct" scope="col" class=" poptip center" data-tip="&lt;strong&gt;3-Point Attempt Rate&lt;/strong&gt;&lt;br&gt;Percentage of FG Attempts from 3-Point Range" data-over-header="Advanced Box Score Stats">3PAr</th>
         <th aria-label="Free Throw Attempt Rate" data-stat="fta_per_fga_pct" scope="col" class=" poptip center" data-tip="&lt;strong&gt;Free Throw Attempt Rate&lt;/strong&gt;&lt;br&gt;Number of FT Attempts Per FG Attempt" data-over-header="Advanced Box Score Stats">FTr</th>
         <th aria-label="Offensive Rebound Percentage" data-stat="orb_pct" scope="col" class=" poptip center" data-tip="&lt;b&gt;Offensive Rebound Percentage&lt;/b&gt;&lt;br&gt;An estimate of the percentage of available offensive rebounds a player grabbed while they were on the floor." data-over-header="Advanced Box Score Stats">ORB%</th>
         <th aria-label="Defensive Rebound Percentage" data-stat="drb_pct" scope="col" class=" poptip center" data-tip="&lt;b&gt;Defensive Rebound Percentage&lt;/b&gt;&lt;br&gt;An estimate of the percentage of available defensive rebounds a player grabbed while they were on the floor." data-over-header="Advanced Box Score Stats">DRB%</th>
         <th aria-label="Total Rebound Percentage" data-stat="trb_pct" scope="col" class=" poptip center" data-tip="&lt;b&gt;Total Rebound Percentage&lt;/b&gt;&lt;br&gt;An estimate of the percentage of available rebounds a player grabbed while they were on the floor." data-over-header="Advanced Box Score Stats">TRB%</th>
         <th aria-label="Assist Percentage" data-stat="ast_pct" scope="col" class=" poptip center" data-tip="&lt;b&gt;Assist Percentage&lt;/b&gt;&lt;br&gt;An estimate of the percentage of teammate field goals a player assisted while they were on the floor." data-over-header="Advanced Box Score Stats">AST%</th>
         <th aria-label="Steal Percentage" data-stat="stl_pct" scope="col" class=" poptip center" data-tip="&lt;b&gt;Steal Percentage&lt;/b&gt;&lt;br&gt;An estimate of the percentage of opponent possessions that end with a steal by the player while they were on the floor." data-over-header="Advanced Box Score Stats">STL%</th>
         <th aria-label="Block Percentage" data-stat="blk_pct" scope="col" class=" poptip center" data-tip="&lt;b&gt;Block Percentage&lt;/b&gt;&lt;br&gt;An estimate of the percentage of opponent two-point field goal attempts blocked by the player while they were on the floor." data-over-header="Advanced Box Score Stats">BLK%</th>
         <th aria-label="Turnover Percentage" data-stat="tov_pct" scope="col" class=" poptip sort_default_asc center" data-tip="&lt;b&gt;Turnover Percentage&lt;/b&gt;&lt;br&gt;An estimate of turnovers committed per 100 plays." data-over-header="Advanced Box Score Stats">TOV%</th>
         <th aria-label="Usage Percentage" data-stat="usg_pct" scope="col" class=" poptip center" data-tip="&lt;b&gt;Usage Percentage&lt;/b&gt;&lt;br&gt;An estimate of the percentage of team plays used by a player while they were on the floor." data-over-header="Advanced Box Score Stats">USG%</th>
         <th aria-label="Offensive Rating" data-stat="off_rtg" scope="col" class=" poptip center" data-tip="&lt;b&gt;Offensive Rating&lt;/b&gt;&lt;br&gt;An estimate of points produced (players) or scored (teams) per 100 possessions" data-over-header="Advanced Box Score Stats">ORtg</th>
         <th aria-label="Defensive Rating" data-stat="def_rtg" scope="col" class=" poptip sort_default_asc center" data-tip="&lt;b&gt;Defensive Rating&lt;/b&gt;&lt;br&gt;An estimate of points allowed per 100 possessions" data-over-header="Advanced Box Score Stats">DRtg</th>
         <th aria-label="BPM" data-stat="bpm" scope="col" class=" poptip right" data-tip="&lt;b&gt;Box Plus/Minus&lt;/b&gt;&lt;br&gt;A box score estimate of the points per 100 possessions a player contributed above a league-average player, translated to an average team." data-over-header="Advanced Box Score Stats">BPM</th>
      </tr>
      </thead>
